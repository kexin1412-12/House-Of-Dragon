# 后端 API 地址（部署到 Render/Railway/Fly 后填该 service 的 URL）
# 不设默认 http://localhost:5000
REACT_APP_API_URL=https://your-backend.onrender.com

# 视频 CDN 根 URL（Cloudflare R2 / HF / 任意 public bucket）
# 不设时回落到 REACT_APP_API_URL，即由后端 /uploads 静态托管（开发模式）
# 注意：需在 R2 bucket 内保留 uploads/ 路径前缀，例如：
#   https://<bucket>.r2.dev/uploads/house_of_dragon_05.mp4
REACT_APP_VIDEO_CDN=https://your-bucket.r2.dev
