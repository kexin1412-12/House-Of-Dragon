# ─── AI Providers ─────────────────────────────────────────────
# 至少配一个 provider 的 key；framework 会按 router.js 里的任务路由调用。
# 主 provider 没 key 时自动降级到 fallback（见 lib/ai/router.js）。

# OpenAI（默认承担 chat / reasoning / transcription）
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Gemini（默认承担 vision / vision_chat）
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ─── 可选：覆盖 router.js 里的默认任务路由 ─────────────────────
# 任务 → provider/model 映射；不设就用 router.js 默认值。
# AI_VISION_PROVIDER=gemini
# AI_VISION_MODEL=gemini-2.5-flash
# AI_VISION_CHAT_PROVIDER=gemini
# AI_VISION_CHAT_MODEL=gemini-2.5-flash
# AI_CHAT_PROVIDER=openai
# AI_CHAT_MODEL=gpt-4o-mini
# AI_REASONING_PROVIDER=openai
# AI_REASONING_MODEL=gpt-4o

# ─── 闭集人脸识别（可选） ──────────────────────────────────────
FACE_SERVICE_URL=http://127.0.0.1:5001
