# Exclude bulky dirs from the Fly build context. Only files referenced by
# face-service/Dockerfile's COPY commands actually end up in the image,
# but trimming context speeds up uploads and avoids hitting size limits.
.git
node_modules
**/node_modules
client
server/uploads
server/kb/characters/face_refs
server/kb/characters/dragon_refs
server/kb/characters/extracted
server/kb/characters/_suggestions
server/kb/characters/*.backup-*.json
server/scripts/__pycache__
*.pyc
*.log
.DS_Store
